# 공통
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
DATABASE_URL=postgresql://ticket:ticket@localhost:5432/ticketing
JWT_SECRET=dev-only-change-me
SEAT_HOLD_TTL_SEC=300
QUEUE_ADMIT_BATCH=500
QUEUE_ACTIVE_CAPACITY=2000

# KafkaJS v2 파티셔너 마이그레이션 경고 끄기 (신규 프로젝트 → 새 기본 파티셔너 사용)
KAFKAJS_NO_PARTITIONER_WARNING=1

# 서비스별 포트 (로컬)
# gateway=3000  queue-service=3101  reservation-service=3102  payment-service=3103
# gateway가 참조하는 업스트림
QUEUE_URL=http://localhost:3101
RESERVATION_URL=http://localhost:3102
USER_URL=http://localhost:3104
