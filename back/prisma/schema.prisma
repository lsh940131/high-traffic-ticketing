// 진실의 원천(source of truth). Redis는 빠른 게이트, DB가 최종 정합성 보장.
generator client {
  provider     = "prisma-client"
  output       = "../libs/prisma/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// PK 전략: UUIDv7(@default(uuid(7))) + 네이티브 uuid 저장(@db.Uuid).
//  - 시간순 정렬성 → 버스트 insert 시 B-tree 지역성(랜덤 UUIDv4 대비 페이지 분할·단편화↓)
//  - 추측 불가 → 예매/티켓 ID 열거(enumeration) 방지
//  - 앱에서 분산 생성, 16바이트 바이너리 저장으로 인덱스 효율. FK도 @db.Uuid.

// ── enums ──────────────────────────────────────────────
enum TicketStatus {
  AVAILABLE
  HELD
  SOLD
}

enum OrderStatus {
  PENDING // 결제 처리중
  CONFIRMED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  FAILED
  REFUNDED
}

enum OutboxStatus {
  PENDING
  SENT
}

// ── user ───────────────────────────────────────────────
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("users")
}

// ── venue (공연장) ──────────────────────────────────────
model Venue {
  id        String      @id @default(uuid(7)) @db.Uuid
  name      String
  location  String
  seats     VenueSeat[]
  concerts  Concert[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@map("venues")
}

// ── venue_seat (물리 좌석: 공연과 무관, 공연장당 1회 정의 후 재사용) ──
model VenueSeat {
  id        String    @id @default(uuid(7)) @db.Uuid
  venue     Venue     @relation(fields: [venueId], references: [id])
  venueId   String    @db.Uuid
  floor     String
  section   String // 블록번호("103") 또는 "STANDING"
  seatRow   String
  seatNo    Int
  tickets   Ticket[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([venueId, floor, section, seatRow, seatNo])
  @@map("venue_seats")
}

// ── concert (공연) ──────────────────────────────────────
model Concert {
  id           String    @id @default(uuid(7)) @db.Uuid
  venue        Venue     @relation(fields: [venueId], references: [id])
  venueId      String    @db.Uuid
  name         String
  artist       String
  startsAt     DateTime
  endsAt       DateTime // 단일일이면 startsAt와 동일
  opensAt      DateTime
  posterUrl    String?
  detailImages String[]  @default([])
  ageLimit     String?
  notice       String?
  tickets      Ticket[]
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([opensAt])
  @@map("concerts")
}

// ── ticket (공연 × 좌석 = 판매/재고 단위. 오버셀 방지 지점) ──
// grade·price는 공연별 상품 속성. status 원자적 조건부 UPDATE = 오버셀 2차 방어.
model Ticket {
  id           String        @id @default(uuid(7)) @db.Uuid
  concert      Concert       @relation(fields: [concertId], references: [id])
  concertId    String        @db.Uuid
  seat         VenueSeat     @relation(fields: [seatId], references: [id])
  seatId       String        @db.Uuid
  grade        String // STANDING/R/S/A
  price        Int
  status       TicketStatus  @default(AVAILABLE)
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@unique([concertId, seatId]) // 한 공연에서 한 좌석은 단 1장 → 구조적 오버셀 차단
  @@index([concertId, status])
  @@map("tickets")
}

// ── order (주문: 여러 좌석을 한 건으로. 1인 공연당 최대 2매) ──
model Order {
  id        String        @id @default(uuid(7)) @db.Uuid
  orderNo   String        @unique
  user      User          @relation(fields: [userId], references: [id])
  userId    String        @db.Uuid
  concert   Concert       @relation(fields: [concertId], references: [id])
  concertId String        @db.Uuid
  status    OrderStatus   @default(PENDING)
  amount    Int // 총액 스냅샷(원)
  items     Reservation[]
  payment   Payment?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@index([userId, concertId])
  @@map("orders")
}

// ── reservation (주문 항목 = 좌석 1) ────────────────────
// 오버셀은 ticket.status로 보장하므로 ticketId 유니크는 두지 않음(취소→재판매 가능).
model Reservation {
  id        String   @id @default(uuid(7)) @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String   @db.Uuid
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  ticketId  String   @db.Uuid
  unitPrice Int // 구매 시점 가격 스냅샷
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([ticketId])
  @@map("reservations")
}

// ── payment (결제 기록: payment-service 소유, 주문당 1건) ──
model Payment {
  id        String        @id @default(uuid(7)) @db.Uuid
  order     Order         @relation(fields: [orderId], references: [id])
  orderId   String        @unique @db.Uuid
  amount    Int
  status    PaymentStatus @default(PENDING)
  provider  String        @default("mock")
  txId      String?
  failCode   String? // 실패 사유 코드(PaymentFailCode)
  refundedAt DateTime? // 환불 처리 시각(취소 시)
  createdAt  DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("payments")
}

// ── outbox (트랜잭셔널 아웃박스) ────────────────────────
// 비즈니스 변경과 같은 트랜잭션으로 이벤트 기록 → 릴레이가 Kafka로 발행(dual-write 유실 방지).
model Outbox {
  id            String       @id @default(uuid(7)) @db.Uuid
  aggregateType String // 'order' 등
  aggregateId   String       @db.Uuid
  eventType     String // 'order.requested' 등
  payload       Json
  status        OutboxStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  sentAt        DateTime?

  @@index([status, createdAt])
  @@map("outbox")
}
