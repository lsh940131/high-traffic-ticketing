{
  "name": "ticketing-back",
  "version": "0.1.0",
  "scripts": {
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "prisma:generate": "prisma generate",
    "build": "nest build gateway && nest build queue-service && nest build reservation-service && nest build payment-service",
    "build:gateway": "nest build gateway",
    "build:queue-service": "nest build queue-service",
    "build:reservation-service": "nest build reservation-service",
    "build:payment-service": "nest build payment-service",
    "start:gateway": "nest start gateway --watch",
    "start:queue": "nest start queue-service --watch",
    "start:reservation": "nest start reservation-service --watch",
    "start:payment": "nest start payment-service --watch",
    "start:all": "concurrently -n gw,queue,resv,pay \"npm:start:gateway\" \"npm:start:queue\" \"npm:start:reservation\" \"npm:start:payment\"",
    "infra:up": "docker compose -f ../infra/docker/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f ../infra/docker/docker-compose.yml down",
    "dev": "npm run infra:up && npm run start:all",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.2",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.2.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "^1.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^4.1.0",
    "opossum": "^8.1.4",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/opossum": "^8.1.7",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "pino-pretty": "^11.3.0",
    "prisma": "^7.8.0",
    "typescript": "^5.5.0"
  }
}
